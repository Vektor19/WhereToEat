<Project>

  <!--
    Central Package Management for the WhereToEat / ДеПоїсти backend.
    Every NuGet version is pinned here exactly once; project files reference packages
    with <PackageReference Include="..." /> and NO Version attribute. See Step 1.

    FluentAssertions is intentionally pinned to the 7.x line: 8.x moved to a paid
    commercial license, so we stay on the last free major.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Test stack (xUnit + FluentAssertions + NSubstitute). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <!-- FakeTimeProvider for deterministic, sleep-free time-based tests (Step 8 rate-limit gating). -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.10.0" />
  </ItemGroup>

  <!-- Architecture-fitness tests (Step 2): NetArchTest.Rules drives the build-failing
       dependency-direction (Domain → only SharedKernel; Application → no Infrastructure/Host),
       EF-containment (EF only inside Admin.Infrastructure), and module-isolation guards.
       The consumer-to-contract structural scan and the ModuleGrouping helper stay on plain
       System.Reflection (a member-signature scan NetArchTest's predicate model cannot express). -->
  <ItemGroup>
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

  <!-- Data-access stack (Step 4): Dapper for the hand-tuned hot-path SQL, Microsoft.Data.SqlClient
       as the SQL Server provider, DbUp as the script-first migration runner (SQL scripts are the
       schema-of-record). The `geography` column is read/written via WKT (geography::STGeomFromText
       / .STAsText()), so the data layer needs no native SqlServer.Types interop. EF Core is
       intentionally absent — it is allowed ONLY in Admin.Infrastructure (Step 2 EF-containment). -->
  <ItemGroup>
    <PackageVersion Include="Dapper" Version="2.1.66" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageVersion Include="dbup-sqlserver" Version="6.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <!-- Containerized-SQL integration tests (Step 4): Testcontainers spins up a real SQL Server
       container, the migrations run against it, and the Dapper layer is asserted to round-trip. -->
  <ItemGroup>
    <PackageVersion Include="Testcontainers.MsSql" Version="3.10.0" />
  </ItemGroup>

  <!-- Public API host + OIDC resource-server auth (Step 6). JwtBearer validates tokens from the
       external IdP authority/JWKS (we never issue tokens ourselves). Swashbuckle serves Swagger.
       Microsoft.IdentityModel.* powers the signing-key/validation in the auth integration tests. -->
  <!-- Geo module (Step 8): the Nominatim adapter calls OSM/Nominatim over a typed HttpClient with
       Polly resilience (timeouts/retries) registered via Microsoft.Extensions.Http's
       AddPolicyHandler. The JSON options/logging abstractions wire the adapter's response mapping
       and the polite rate-limit. No live Nominatim calls in CI — a mocked HttpMessageHandler serves
       a pinned fixture (invariant #7: we only ever store the OSM-sourced point, never Google lat/lng). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="8.0.11" />
    <PackageVersion Include="Polly.Extensions.Http" Version="3.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <!-- Parsing module (Step 9): two parser strategies behind one IRestaurantParser contract —
       Selenium.WebDriver drives a HEADLESS browser for JS-rendered sites (Selenium Manager
       auto-resolves the matching driver), AngleSharp parses static HTML in-process. The e2e/
       integration tests run against PINNED local HTML fixtures (never the live site — CI-stable),
       and the compliance gates (robots.txt/rate-limit/first-party — invariant #9) run before any
       fetch. Dapper backs the quarantine store; no EF (EF is Admin.Infrastructure-only). -->
  <ItemGroup>
    <PackageVersion Include="Selenium.WebDriver" Version="4.45.0" />
    <PackageVersion Include="AngleSharp" Version="1.5.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.2.1" />
  </ItemGroup>

  <!-- Admin module (Step 10): EF Core is the ONLY data-access stack the Admin module uses, and the
       ONLY place EF is allowed in the whole solution (the Step 2 EF-containment fitness rule). EF maps
       DATABASE-FIRST onto the existing SQL-script-owned schema (Steps 4–5); EF migrations are disabled
       (no Migrations folder, no EnsureCreated/Migrate) and a startup guard fails fast if EF would alter
       the schema. The SQL Server provider drives the low-traffic admin CRUD surface. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
  </ItemGroup>

  <!-- Worker host + background scheduler (Step 12): Quartz.NET with the SQL Server AdoJobStore in
       CLUSTERED mode (Quartz.Extensions.Hosting hosts it inside the generic host). The clustered,
       DB-backed store is what makes a scheduled trigger fire on EXACTLY ONE worker replica even when
       several replicas point at the same DB (the cluster QRTZ_* tables come from migration 0013).
       Misfire/recovery is configured so a missed/aborted run is recovered, not double-run. -->
  <ItemGroup>
    <PackageVersion Include="Quartz" Version="3.13.1" />
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="3.13.1" />
  </ItemGroup>

  <!-- Step 13 cross-cutting infrastructure.
       Redis: StackExchange.Redis backs the ICacheService abstraction (hot read-through caches +
       the distributed parser rate-limit slot-claim); Testcontainers.Redis spins a real Redis for the
       cache integration tests. MassTransit: the in-process transport NOW with a RabbitMQ-by-config
       switch (MassTransit.RabbitMQ), carrying the Contracts integration events; MassTransit.TestFramework
       drives the in-memory consumer harness tests. Observability: Serilog (JSON console sink) for
       structured logging + correlation ids, OpenTelemetry for traces/metrics across API/bus/worker. -->
  <ItemGroup>
    <PackageVersion Include="StackExchange.Redis" Version="2.8.16" />
    <PackageVersion Include="Testcontainers.Redis" Version="3.10.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="3.10.0" />
    <PackageVersion Include="MassTransit" Version="8.3.0" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.3.0" />
    <PackageVersion Include="MassTransit.TestFramework" Version="8.3.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <!-- OpenTelemetry is pinned to the 1.9.x line: it keeps its transitive Microsoft.Extensions.*
         dependencies on the 8.x line (matching the rest of this net8 solution), so it composes under
         central transitive pinning without an NU1109 downgrade. The OTLP wire exporter is intentionally
         omitted — the 1.9.0 OTLP exporter carries a flagged advisory (NU1902, warnings-as-errors), and
         the design only requires traces/metrics to be "OTLP-exportable by config"; the Console exporter
         covers local dev and an OTLP collector can be added later once a non-flagged exporter ships. -->
    <PackageVersion Include="OpenTelemetry" Version="1.9.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.9.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.9.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.9.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.9.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.9.0" />
  </ItemGroup>

</Project>
