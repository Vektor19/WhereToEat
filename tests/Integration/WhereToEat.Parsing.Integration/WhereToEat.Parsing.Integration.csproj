<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Library-parser integration tests for the Parsing module (Step 9). The AngleSharp strategy parses
    the PINNED static-HTML fixture (pizza-house/menu.html) over a file:// URL — CI-stable, never the
    live site — and the test asserts the SAME normalized ParsedMenu contract the Selenium e2e asserts.
    A second class runs the full RunParseCommandHandler over Testcontainers SQL to prove the quarantine
    path: an unmappable dish lands in parsing.ParseQuarantine, the parse does NOT fail, and mappable
    items still persist. Needs Docker for the quarantine test.
  -->
  <PropertyGroup>
    <RootNamespace>WhereToEat.Parsing.Integration</RootNamespace>
    <AssemblyName>WhereToEat.Parsing.Integration</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Testcontainers.MsSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Modules\Parsing\WhereToEat.Parsing.Domain\WhereToEat.Parsing.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Parsing\WhereToEat.Parsing.Application\WhereToEat.Parsing.Application.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Parsing\WhereToEat.Parsing.Infrastructure\WhereToEat.Parsing.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\Shared\WhereToEat.SharedKernel\WhereToEat.SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\src\Shared\WhereToEat.Contracts\WhereToEat.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\Shared\WhereToEat.BuildingBlocks.Persistence\WhereToEat.BuildingBlocks.Persistence.csproj" />
    <ProjectReference Include="..\..\..\src\Shared\WhereToEat.BuildingBlocks.Migrations\WhereToEat.BuildingBlocks.Migrations.csproj" />
  </ItemGroup>

  <!-- Copy the pinned HTML fixtures next to the test assembly so file:// URLs resolve at runtime. -->
  <ItemGroup>
    <None Include="Fixtures\**\*.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
