<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-cutting integration tests (Step 13) — the Redis cache, the transparent price-median caching
    decorator, the MassTransit consumers, correlation-id propagation across a publish→consume hop, and
    the Keycloak dev-realm/authorization assertions:
      - RedisCacheService get/set/remove/expiry against a Redis Testcontainer;
      - CachingPriceMedianProvider: miss→DB→populate then hit→no-DB, identical values vs DB-only
        (Step 7 results unchanged with caching on/off) — over a SQL Testcontainer;
      - the two consumers handle MenuUpdated/AddressChanged via the MassTransit in-memory test harness
        and reference ONLY Contracts;
      - a correlation id survives a publish→consume hop;
      - the dev Keycloak realm export defines the admin + user roles/scopes and a JWT carrying the
        admin role satisfies the AdminAuthorization admin-only policy while user→deny, anon→deny.
    The Redis/SQL tests need Docker; the harness/realm/policy tests do not.
  -->
  <PropertyGroup>
    <RootNamespace>WhereToEat.CrossCutting.Integration</RootNamespace>
    <AssemblyName>WhereToEat.CrossCutting.Integration</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="MassTransit" />
    <PackageReference Include="MassTransit.TestFramework" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
  </ItemGroup>

  <!-- The admin-policy test evaluates AuthorizationOptions/ClaimsPrincipal directly, so it needs the
       ASP.NET Core shared framework (the same FrameworkReference BuildingBlocks.Auth uses). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Shared\WhereToEat.BuildingBlocks.Caching\WhereToEat.BuildingBlocks.Caching.csproj" />
    <ProjectReference Include="..\..\..\src\Shared\WhereToEat.BuildingBlocks.Messaging\WhereToEat.BuildingBlocks.Messaging.csproj" />
    <ProjectReference Include="..\..\..\src\Shared\WhereToEat.BuildingBlocks.Observability\WhereToEat.BuildingBlocks.Observability.csproj" />
    <ProjectReference Include="..\..\..\src\Shared\WhereToEat.BuildingBlocks.Persistence\WhereToEat.BuildingBlocks.Persistence.csproj" />
    <ProjectReference Include="..\..\..\src\Shared\WhereToEat.BuildingBlocks.Migrations\WhereToEat.BuildingBlocks.Migrations.csproj" />
    <ProjectReference Include="..\..\..\src\Shared\WhereToEat.BuildingBlocks.Auth\WhereToEat.BuildingBlocks.Auth.csproj" />
    <ProjectReference Include="..\..\..\src\Shared\WhereToEat.Contracts\WhereToEat.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Recommendation\WhereToEat.Recommendation.Application\WhereToEat.Recommendation.Application.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Recommendation\WhereToEat.Recommendation.Infrastructure\WhereToEat.Recommendation.Infrastructure.csproj" />
  </ItemGroup>

  <!-- The dev Keycloak realm export is asserted by a file-content test, so it must be findable at
       test runtime. Linked + copied to the output so the test reads it without an absolute path. -->
  <ItemGroup>
    <None Include="..\..\..\deploy\keycloak\realm-export.json" Link="keycloak\realm-export.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
