<?xml version="1.0" encoding="utf-8"?>
<!--
  Solution-level run settings for the full-solution test run (Step 13, Item B).

  The integration / E2E suites spin up Testcontainers (SQL Server, Redis, RabbitMQ). When VSTest runs
  the test ASSEMBLIES in parallel (its default), several suites race to pull or start containers at once
  and intermittently collide on Docker startup (port or timeout flakes). MaxCpuCount of one serializes
  the assembly-level test execution so only ONE integration assembly's containers start at a time, which
  makes the full-solution run reliably green. Combined with the per-project xunit.runner.json that
  disables intra-assembly parallel collections, container fixtures never overlap.

  Run the full suite by passing this file via the dotnet test "settings" option:
    dotnet test src/WhereToEat.sln (settings) tests/WhereToEat.runsettings
-->
<RunSettings>
  <RunConfiguration>
    <!-- Serialize test assemblies (one at a time) so parallel container startup cannot collide. -->
    <MaxCpuCount>1</MaxCpuCount>
  </RunConfiguration>
</RunSettings>
