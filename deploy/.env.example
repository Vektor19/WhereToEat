# WhereToEat / ДеПоїсти — local dev environment (Step 13).
# Copy to deploy/.env and adjust, then:
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up --build
# These are DEV defaults only — never reuse these secrets anywhere real.

# ---- SQL Server -----------------------------------------------------------------------------------
MSSQL_SA_PASSWORD=Your_Strong_Passw0rd!
MSSQL_PORT=1433
# The connection string every host + the migration runner use (service name `sqlserver` on the compose network).
DB_CONNECTION=Server=sqlserver,1433;Database=WhereToEat;User Id=sa;Password=Your_Strong_Passw0rd!;TrustServerCertificate=True;Encrypt=False

# ---- Redis ----------------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_CONNECTION=redis:6379

# ---- RabbitMQ -------------------------------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
# Transport selector for MassTransit: InMemory (no broker) or RabbitMq (uses the broker above).
MESSAGING_TRANSPORT=RabbitMq

# ---- Keycloak (dev IdP) ---------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8088
# The realm `wheretoeat` is imported from deploy/keycloak/realm-export.json (admin + user roles).
OIDC_AUTHORITY=http://keycloak:8080/realms/wheretoeat
OIDC_AUDIENCE=wheretoeat-api

# ---- Analytics ------------------------------------------------------------------------------------
ANALYTICS_SALT_SECRET=dev-only-salt-master-secret-change-me

# ---- Hosts / environment --------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
PUBLIC_API_PORT=8080
ADMIN_API_PORT=8081

# ---- Config-driven scaling knobs ------------------------------------------------------------------
# Replica counts (the worker is safe to scale — clustered Quartz fires each trigger on exactly one).
PUBLIC_API_REPLICAS=1
ADMIN_API_REPLICAS=1
WORKER_REPLICAS=1

# Per-service resource limits (compose `deploy.resources.limits`).
PUBLIC_API_CPU_LIMIT=1.0
PUBLIC_API_MEM_LIMIT=512M
ADMIN_API_CPU_LIMIT=1.0
ADMIN_API_MEM_LIMIT=512M
WORKER_CPU_LIMIT=1.0
WORKER_MEM_LIMIT=512M
