{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Catalog": ""
  },
  "Authentication": {
    "Oidc": {
      "Authority": "",
      "Audience": "wheretoeat-api",
      "RequireHttpsMetadata": true
    }
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": ""
  },
  "Messaging": {
    "Transport": "InMemory",
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "OpenTelemetry": {
    "ConsoleExporter": false
  },
  "Nominatim": {
    "BaseUrl": "https://nominatim.openstreetmap.org/",
    "UserAgent": "WhereToEat/1.0 (ДеПоїсти; contact: ops@wheretoeat.example)",
    "Attribution": "© OpenStreetMap contributors (ODbL)",
    "MinRequestIntervalMs": 1000,
    "RequestTimeoutMs": 10000,
    "RetryCount": 2,
    "RetryBaseDelayMs": 500
  }
}
