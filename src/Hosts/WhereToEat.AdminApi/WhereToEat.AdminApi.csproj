<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Admin API host (Step 10): a SEPARATE composition root from the public host (its own port/config,
    security isolation per the design). It validates the SAME OIDC tokens as the public host but
    authorizes ONLY admin roles/scopes (the AdminAuthorization admin-only policy). As a Host it is the
    place allowed to reference module Infrastructure for composition: it wires the Admin module (EF
    Core — the only place EF is allowed) and the Geo module (so the address-edit re-geocode flow has a
    handler to dispatch to). EF migrations are disabled; the host runs the EfMigrationsDisabledGuard at
    startup so a schema drift fails fast.
  -->
  <PropertyGroup>
    <RootNamespace>WhereToEat.AdminApi</RootNamespace>
    <AssemblyName>WhereToEat.AdminApi</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Admin\WhereToEat.Admin.Application\WhereToEat.Admin.Application.csproj" />
    <ProjectReference Include="..\..\Modules\Admin\WhereToEat.Admin.Infrastructure\WhereToEat.Admin.Infrastructure.csproj" />
    <!-- The Geo module supplies the re-geocode handler the address-edit flow dispatches to (Step 8).
         As a Host this is the place allowed to compose another module's Infrastructure. The catalog
         coordinate-writer seam Geo writes through is supplied by the Catalog module's registration. -->
    <ProjectReference Include="..\..\Modules\Geo\WhereToEat.Geo.Application\WhereToEat.Geo.Application.csproj" />
    <ProjectReference Include="..\..\Modules\Geo\WhereToEat.Geo.Infrastructure\WhereToEat.Geo.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Catalog\WhereToEat.Catalog.Infrastructure\WhereToEat.Catalog.Infrastructure.csproj" />
    <!-- Step 14: the Monetization module (Verified/ads behind the no-op payment seam). As a Host this
         is the place allowed to compose another module's Application + Infrastructure; the admin
         endpoints manage Verified/ads under the same admin-only policy. -->
    <ProjectReference Include="..\..\Modules\Monetization\WhereToEat.Monetization.Application\WhereToEat.Monetization.Application.csproj" />
    <ProjectReference Include="..\..\Modules\Monetization\WhereToEat.Monetization.Infrastructure\WhereToEat.Monetization.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Shared\WhereToEat.BuildingBlocks.Auth\WhereToEat.BuildingBlocks.Auth.csproj" />
    <ProjectReference Include="..\..\Shared\WhereToEat.Contracts\WhereToEat.Contracts.csproj" />
    <!-- Step 13 cross-cutting: Redis cache, MassTransit bus, observability (logging/correlation/OTel). -->
    <ProjectReference Include="..\..\Shared\WhereToEat.BuildingBlocks.Caching\WhereToEat.BuildingBlocks.Caching.csproj" />
    <ProjectReference Include="..\..\Shared\WhereToEat.BuildingBlocks.Messaging\WhereToEat.BuildingBlocks.Messaging.csproj" />
    <ProjectReference Include="..\..\Shared\WhereToEat.BuildingBlocks.Observability\WhereToEat.BuildingBlocks.Observability.csproj" />
  </ItemGroup>

  <!-- The integration tests drive the host via WebApplicationFactory and need its internals
       (Program is implicitly internal in a top-level-statement host). -->
  <ItemGroup>
    <InternalsVisibleTo Include="WhereToEat.AdminApi.Integration" />
  </ItemGroup>

</Project>
