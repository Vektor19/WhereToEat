<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Admin Domain (Step 5): the restaurant-level admin > parser protection (invariant #3) — the
    DoNotUpdate flag that shields a hand-curated venue from the parser, complementing Step 3's
    per-MenuItem DoNotParse. The admin API host + EF-backed CRUD that SETS these flags arrive in
    Step 10; this is the persistence-free domain shape. Note: EF Core is allowed ONLY in
    Admin.Infrastructure (a later step) — this Admin.Domain references ONLY WhereToEat.SharedKernel,
    and the Step 2 dependency-direction fitness test (Domain -> only SharedKernel) guards it.
  -->
  <PropertyGroup>
    <RootNamespace>WhereToEat.Admin.Domain</RootNamespace>
    <AssemblyName>WhereToEat.Admin.Domain</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\WhereToEat.SharedKernel\WhereToEat.SharedKernel.csproj" />
  </ItemGroup>

</Project>
