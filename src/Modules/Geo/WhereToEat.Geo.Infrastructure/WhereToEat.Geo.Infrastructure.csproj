<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Geo Infrastructure (Step 8): the OSM/Nominatim adapter behind the Geo.Application IGeocoder port.
    NominatimGeocoder calls Nominatim over a typed HttpClient (Microsoft.Extensions.Http) wrapped with
    a Polly resilience policy (timeout + retry) and a polite minimum-request-interval rate-limit, sets
    a descriptive User-Agent + attribution per Nominatim's usage policy, and maps a successful response
    into the OSM-sourced GeoCoordinatesDto (NEVER a Google coordinate — invariant #7). It references
    only its own module's Application + SharedKernel + Contracts + the Microsoft.Extensions.* DI/HTTP
    abstractions; never another module's internals and no EF (EF is Admin.Infrastructure-only).
  -->
  <PropertyGroup>
    <RootNamespace>WhereToEat.Geo.Infrastructure</RootNamespace>
    <AssemblyName>WhereToEat.Geo.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" />
    <PackageReference Include="Polly.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WhereToEat.Geo.Application\WhereToEat.Geo.Application.csproj" />
    <ProjectReference Include="..\..\..\Shared\WhereToEat.SharedKernel\WhereToEat.SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\Shared\WhereToEat.Contracts\WhereToEat.Contracts.csproj" />
  </ItemGroup>

</Project>
