<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Catalog.Application (Step 6): the use-case layer for the public read endpoints — list
    categories, list dishes in a category, restaurant details (always including the free contact
    links — §5.8), and the DB-only Map payload (stored coordinates / Place ID / deep-link only —
    §5.7, NO geocoder). Handlers orchestrate over the Catalog domain's ICatalogRepository port and
    return plain response DTOs the host maps to JSON. Per the layer rule it references only the
    Catalog Domain + SharedKernel (+ DI abstractions for the AddCatalogModule extension); it must
    NEVER reference Infrastructure or a Host (the Step 2 fitness test guards this).
  -->
  <PropertyGroup>
    <RootNamespace>WhereToEat.Catalog.Application</RootNamespace>
    <AssemblyName>WhereToEat.Catalog.Application</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WhereToEat.Catalog.Domain\WhereToEat.Catalog.Domain.csproj" />
  </ItemGroup>

</Project>
