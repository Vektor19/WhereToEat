<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ratings Application (Step 21): the submit-rating use-case — a registered user scoring a venue
    (invariant #6). The handler maps the caller's opaque UserRef + RestaurantRef + score, decides
    revise-vs-create through the IRatingRepository write port, persists the raw Rating fact, and
    publishes the Contracts RatingGiven integration event through the IRatingGivenPublisher seam so the
    existing recompute job + cumulative all-time aggregate produce the smoothed value the recommend/
    details paths already display. It orchestrates over ports only — no EF/Dapper/MassTransit reference
    here (Application -> Domain + SharedKernel + Contracts only, the dependency-direction rule b). The
    Dapper adapter, the MassTransit-backed publisher, and the AddRatingsApplication DI extension live in
    WhereToEat.Ratings.Infrastructure (mirroring AddAdminModule), so this project never depends on
    Infrastructure (the Application_DependsOnNoInfrastructureAndNoHost fitness test).
  -->
  <PropertyGroup>
    <RootNamespace>WhereToEat.Ratings.Application</RootNamespace>
    <AssemblyName>WhereToEat.Ratings.Application</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\WhereToEat.SharedKernel\WhereToEat.SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\Shared\WhereToEat.Contracts\WhereToEat.Contracts.csproj" />
    <ProjectReference Include="..\WhereToEat.Ratings.Domain\WhereToEat.Ratings.Domain.csproj" />
  </ItemGroup>

</Project>
