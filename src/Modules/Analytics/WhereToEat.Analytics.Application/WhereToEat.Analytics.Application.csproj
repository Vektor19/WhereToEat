<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Analytics.Application (Step 11): the ingest use-case layer. It defines the IngestEventCommand +
    handler, the IAnonymizer / ISaltProvider ports (the retain/hash/drop anonymization-at-ingest seam),
    and the IAnalyticsRollupReader aggregation seam future B2B dashboards read (aggregates only —
    invariant #11). The handler anonymizes every raw event BEFORE persistence, then appends through the
    Domain's append-optimized IAnalyticsEventStore. Per the layer rule it references only its own Domain
    + SharedKernel (+ Logging/DI abstractions); NEVER Infrastructure or a Host (Step 2 fitness test).
  -->
  <PropertyGroup>
    <RootNamespace>WhereToEat.Analytics.Application</RootNamespace>
    <AssemblyName>WhereToEat.Analytics.Application</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WhereToEat.Analytics.Domain\WhereToEat.Analytics.Domain.csproj" />
  </ItemGroup>

</Project>
