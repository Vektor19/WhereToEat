{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build core && ng build app",
    "watch": "ng build app --watch --configuration development",
    "test": "ng test core --watch=false && ng test app --watch=false",
    "test:coverage": "ng test core --watch=false --configuration coverage && ng test app --watch=false --configuration coverage",
    "lint": "ng lint",
    "e2e": "playwright test",
    "format": "prettier --check \"{projects,e2e}/**/*.{ts,html,scss,json}\"",
    "format:write": "prettier --write \"{projects,e2e}/**/*.{ts,html,scss,json}\""
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ngx-translate/core": "^18.0.0",
    "angular-oauth2-oidc": "^21.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.16",
    "@angular/cli": "^21.2.16",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@vitest/coverage-v8": "^4.1.9",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.4.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
